[Unit]
Description=quizmitbenny FastAPI app
After=network.target mariadb.service

[Service]
Type=simple
User=quizmitbenny
Group=quizmitbenny
WorkingDirectory=/opt/quizmitbenny
ExecStart=/opt/quizmitbenny/env/bin/uvicorn app.main:app --host 127.0.0.1 --port 8765
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
