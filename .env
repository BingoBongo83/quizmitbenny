# Admin password for the moderator panel (required for remote use)
QUIZ_ADMIN_PASSWORD=123456

# Secret for session cookies (generate: openssl rand -hex 32)
QUIZ_SECRET_KEY=changeme

# Optional: full SQLAlchemy URL overrides database.ini
DATABASE_URL=
# For local dev without MariaDB:
# DATABASE_URL=sqlite:///./quiz_dev.db

# Azure OpenAI for question translation (preferred; MODEL = deployment name)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# OpenAI API key (used when no Azure deployment is configured)
OPENAI_API_KEY=

# DeepL API key for question seeding (fallback, free key at deepl.com/pro-api)
DEEPL_API_KEY=

# Optional token the local buzzer bridge uses to authenticate
QUIZ_BUZZER_TOKEN=
